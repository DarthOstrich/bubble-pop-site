---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	frontmatter: {
		title: string;
		description: string;
		pubDate?: string;
		updatedDate?: string;
	};
}

const { title, description, pubDate, updatedDate } = Astro.props.frontmatter;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article class="mx-auto max-w-3xl px-4 py-12">
				<div class="mb-8 text-center">
					{
						pubDate && (
							<div class="mb-2 text-sm text-slate/70">
								<FormattedDate date={new Date(pubDate)} />
								{updatedDate && (
									<div class="italic">
										Last updated on <FormattedDate date={new Date(updatedDate)} />
									</div>
								)}
							</div>
						)
					}
					<h1 class="text-4xl font-bold text-slate">{title}</h1>
					<hr class="mt-6 border-skyblue" />
				</div>
				<div class="content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.content :global(h2) {
		margin: 1.5em 0 0.5em;
		font-size: 1.5em;
		font-weight: bold;
		color: var(--color-slate);
	}
	.content :global(p) {
		margin-bottom: 1em;
		line-height: 1.7;
	}
	.content :global(ul) {
		margin: 0 0 1em 1.25em;
		list-style: disc;
	}
	.content :global(li) {
		margin-bottom: 0.5em;
		line-height: 1.7;
	}
	.content :global(a) {
		color: var(--color-slate);
		text-decoration: underline;
		text-decoration-color: var(--color-blush);
	}
	.content :global(strong) {
		font-weight: bold;
	}
</style>
