---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="bg-eggshell/80 backdrop-blur sticky top-0 z-10 shadow-sm">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
		<a href="/" class="flex items-center gap-2 text-lg font-bold text-slate no-underline">
			<img src="/bubble-pop-icon.png" alt="" width="32" height="32" class="rounded-lg" />
			{SITE_TITLE}
		</a>
		<div class="flex gap-1">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/privacy">Privacy Policy</HeaderLink>
		</div>
	</nav>
</header>
